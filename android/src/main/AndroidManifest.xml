<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.apprefer.sdk">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Testimonial capture: find the system camera app (Android 11+ package visibility). No camera permission is declared. -->
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.media.action.VIDEO_CAPTURE" /></intent>
    </queries>
    <application>
        <!-- Lifecycle notifications: snooze, dismiss and re-show. Not exported: only the plugin's own PendingIntents reach it. -->
        <receiver android:name="com.apprefer.flutter.engagement.EngagementRenderer$Receiver" android:exported="false" />
        <!-- The camera app writes one still photo into the plugin's private cache file through a one-off grant. Not exported. -->
        <provider android:name="com.apprefer.flutter.testimonial.TestimonialMedia$CaptureProvider" android:authorities="${applicationId}.apprefer.flutter.testimonial.capture" android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
